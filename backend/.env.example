# 1. مفتاح API الخاص بمتجر Zfour (من شاشة API داخل بوت Zfour - يبدأ بـ psk_)
ZFOUR_API_KEY="psk_2f3df2ac380ad6ae420d0f28efcccbfcadbb9bb6fc12c0c6"

# 2. بيانات اعتماد التاجر في منصة إيصالات (من لوحة تحكم إيصالات -> مفاتيح API)
ESAALAT_CLIENT_ID=
ESAALAT_CLIENT_SECRET=

# 3. سر التحقق من توقيع Webhook إيصالات (من لوحة تحكم إيصالات -> Webhooks عند إضافة الرابط)
WEBHOOK_SECRET=

# 4. تفعيل محفظة الاختبار في إيصالات أثناء التجارب فقط (ضع 0 في الإنتاج الفعلي)
ESAALAT_INCLUDE_TEST_WALLET=0

# 5. بيانات مصادقة المدير للوحة التحكم المركزية
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# 6. إعدادات النطاقات والأمان (CORS)
PUBLIC_SITE_URL=
ALLOWED_ORIGIN=
STORE_NAME=

# 7. إعدادات قاعدة البيانات وتخزين الصور (تُربط في wrangler.toml)
DATABASE_URL=
R2_BUCKET_NAME=
